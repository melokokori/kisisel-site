---
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Dil önekinden arındırılmış yol, ör. /projects/x */
  path: string;
}

const { lang, path } = Astro.props;
const ui = t(lang);
const otherLang: Lang = lang === 'tr' ? 'en' : 'tr';

const items = [
  { href: '/projects', label: ui.nav.projects },
  { href: '/research', label: ui.nav.research },
  { href: '/writing', label: ui.nav.writing },
  { href: '/about', label: ui.nav.about },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <a href={localePath(lang)} class="brand mono">melih.turgut</a>
  <nav aria-label={ui.mainMenu}>
    {
      items.map((item) => (
        <a href={localePath(lang, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={localePath(otherLang, path)} hreflang={otherLang} lang={otherLang} class="muted">{ui.switchLang}</a>
    <button type="button" class="theme-toggle" aria-label={ui.themeToggle} title={ui.themeToggle}>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
    </button>
    <a href={localePath(lang, '/about#contact')} class="contact-pill">{ui.nav.contact}</a>
  </nav>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding: 24px 0;
  }
  .brand {
    font-size: 14px;
    color: var(--tx);
    text-decoration: none;
    padding: 12px 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    font-size: 15px;
  }
  nav a {
    color: var(--tx);
    text-decoration: none;
    padding: 12px;
  }
  nav a[aria-current='page'] {
    color: var(--ac);
  }
  nav a.muted {
    color: var(--mu);
  }
  .contact-pill {
    margin-left: 6px;
    padding: 10px 18px !important;
    border: 1px solid var(--ln2);
    border-radius: 999px;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--tx);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--sf);
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  :global([data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }
</style>
