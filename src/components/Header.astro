---
import { localePath, t, type Lang } from '../i18n';
import { getProjects, getPosts } from '../lib/content';

interface Props {
  lang: Lang;
  /** Dil önekinden arındırılmış yol, ör. /projects/x */
  path: string;
}

const { lang, path } = Astro.props;
const ui = t(lang);
const otherLang: Lang = lang === 'tr' ? 'en' : 'tr';

const [projects, posts] = await Promise.all([getProjects(lang), getPosts(lang)]);
const items = [
  { href: '/projects', label: ui.nav.projects, show: projects.length > 0 },
  { href: '/research', label: ui.nav.research, show: true },
  { href: '/writing', label: ui.nav.writing, show: posts.length > 0 },
  { href: '/about', label: ui.nav.about, show: true },
].filter((item) => item.show);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <a href={localePath(lang)} class="brand mono">melih.turgut</a>
  <nav class="links" aria-label={ui.mainMenu}>
    {
      items.map((item) => (
        <a href={localePath(lang, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={localePath(lang, '/about#contact')} class="nav-contact">{ui.nav.contact}</a>
  </nav>
  <div class="tools">
    <a href={localePath(otherLang, path)} hreflang={otherLang} lang={otherLang} class="lang">{ui.switchLang}</a>
    <button type="button" class="theme-toggle" aria-label={ui.themeToggle} title={ui.themeToggle}>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
    </button>
    <a href={localePath(lang, '/about#contact')} class="contact-pill">{ui.nav.contact}</a>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = next === 'light' ? '#f5f7fb' : '#0b0e17';
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 24px 0;
  }
  .brand {
    margin-right: auto;
    font-size: 14px;
    color: var(--tx);
    text-decoration: none;
    padding: 12px 0;
  }
  .links,
  .tools {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 15px;
  }
  .links a,
  .lang {
    position: relative;
    color: var(--tx);
    text-decoration: none;
    padding: 12px;
  }
  /* Alt çizgi soldan sağa uzar; etkin sayfada kalıcıdır */
  .links a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .links a:hover::after,
  .links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .links a[aria-current='page'] {
    color: var(--ac);
  }
  .lang {
    color: var(--mu);
    font-family: var(--mono);
    font-size: 13px;
    transition: color 0.2s;
  }
  .lang:hover {
    color: var(--tx);
  }
  .nav-contact {
    display: none;
  }
  .contact-pill {
    margin-left: 6px;
    padding: 10px 18px;
    border: 1px solid var(--ln2);
    border-radius: 999px;
    color: var(--tx);
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.25s;
  }
  .contact-pill:hover {
    border-color: var(--ac);
    box-shadow: var(--glow);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--tx);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .theme-toggle:hover {
    background: var(--sf);
  }
  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    transition: transform 0.4s var(--ease);
  }
  .theme-toggle:hover svg {
    transform: rotate(-20deg);
  }
  :global([data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }

  /* Mobil: üstte logo + araçlar, altta menü satırı (öğe artarsa yatay kayar) */
  @media (max-width: 720px) {
    .site-header {
      flex-wrap: wrap;
      padding: 8px 0 0;
    }
    .links {
      order: 3;
      flex-basis: calc(100% + 2 * var(--gutter));
      margin: 4px calc(-1 * var(--gutter)) 0;
      padding: 0 calc(var(--gutter) - 12px);
      border-top: 1px solid var(--ln);
      border-bottom: 1px solid var(--ln);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .links a {
      flex-shrink: 0;
    }
    .nav-contact {
      display: block;
    }
    .contact-pill {
      display: none;
    }
  }
</style>
