---
import { t, type Lang } from '../i18n';

interface Props {
  id: string;
  title: string;
  lang: Lang;
  /** false ise içerik yerine "yakında" notu gösterilir. */
  filled: boolean;
}

const { id, title, lang, filled } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  {filled ? <slot /> : <p class="empty">{t(lang).emptySection}</p>}
</section>
