---
import { profile } from '../data/profile';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Görüntülenme genişliği ipucu (srcset seçimi için). */
  sizes?: string;
  eager?: boolean;
}

const { lang, sizes = '(max-width: 760px) 240px, 360px', eager = false } = Astro.props;
const alt = lang === 'tr' ? `${profile.name} — portre` : `${profile.name} — portrait`;
---

<figure class="avatar">
  <img
    src="/images/avatar-900.webp"
    srcset="/images/avatar-480.webp 480w, /images/avatar-900.webp 900w"
    {sizes}
    width="900"
    height="1125"
    {alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</figure>

<style>
  .avatar {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--ln);
    /* Portrenin kendi zemini (#0b0e17) yüklenirken de aynı renk görünsün */
    background: #0b0e17;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
