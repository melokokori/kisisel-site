---
// Monogram: "M" harfi, ortası taban çizgisinin altına inen bir sinyal atışı olarak çizilir.
// Aynı şekil favicon'da (public/favicon.svg) ve iOS ikonunda (scripts/apple-touch-icon.svg) kullanılır.
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg class="logo" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
  <rect x="0.5" y="0.5" width="31" height="31" rx="8" class="tile"></rect>
  <polyline points="4,21 8.5,21 11,8 16,24 21,8 23.5,21 28,21" class="mark"></polyline>
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }
  .tile {
    fill: var(--sf);
    stroke: var(--ln2);
    stroke-width: 1;
  }
  .mark {
    fill: none;
    stroke: var(--ac);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
