---
// Ana sayfanın parallax arka planı: şekil yok, yalnızca üç derinlikte yumuşak ışık
// bulutları (mavi + mor). Kaydırınca farklı hızda yükselir (uzak yavaş, yakın hızlı),
// masaüstünde fareye de hafifçe tepki verir. Her katmanda --d: kaydırmada toplam
// yükselme, --m: fareyle en fazla kayma.
---

<div class="pbg" aria-hidden="true">
  <div class="layer far" style="--d: 120px; --m: 12px"></div>
  <div class="layer mid" style="--d: 320px; --m: 26px"></div>
  <div class="layer near" style="--d: 560px; --m: 44px"></div>
</div>

<script>
  // Fare parallax'ı: yalnızca fare/kalem olan cihazlarda ve hareket azaltma kapalıyken
  const root = document.querySelector<HTMLElement>('.pbg');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && finePointer && !reduce) {
    let frame = 0;
    let x = 0;
    let y = 0;
    addEventListener(
      'pointermove',
      (e) => {
        x = (e.clientX / innerWidth) * 2 - 1;
        y = (e.clientY / innerHeight) * 2 - 1;
        frame ||= requestAnimationFrame(() => {
          frame = 0;
          root.style.setProperty('--mx', x.toFixed(3));
          root.style.setProperty('--my', y.toFixed(3));
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  .pbg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* İkinci ışık rengi: vurgu mavisinin mora kayan komşusu */
    --blue: var(--ac);
    --violet: #9b7cff;
  }
  :global([data-theme='light']) .pbg {
    --violet: #7b5cf0;
  }
  .layer {
    position: absolute;
    /* Fareyle --m kadar kaydığı için her yandan o kadar taşar (kenar açığa çıkmasın);
       kaydırınca --d kadar yükseldiği için alttan da o kadar uzun */
    top: calc(-1 * var(--m));
    left: calc(-1 * var(--m));
    width: calc(100% + 2 * var(--m));
    height: calc(100lvh + var(--d) + 2 * var(--m));
    /* Fare: imlecin tersine kayar (derinlik hissi); geçiş gecikmesi hareketi yumuşatır */
    transform: translate3d(calc(var(--mx, 0) * var(--m) * -1), calc(var(--my, 0) * var(--m) * -1), 0);
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  /* Uzak: geniş, soluk bulutlar */
  .far {
    background:
      radial-gradient(900px 620px at 72% 6%, color-mix(in oklab, var(--blue) 21%, transparent), transparent 70%),
      radial-gradient(820px 560px at 8% 58%, color-mix(in oklab, var(--violet) 15%, transparent), transparent 70%);
  }
  /* Orta */
  .mid {
    background:
      radial-gradient(560px 400px at 88% 52%, color-mix(in oklab, var(--violet) 19%, transparent), transparent 70%),
      radial-gradient(480px 360px at 34% 14%, color-mix(in oklab, var(--blue) 14%, transparent), transparent 70%),
      radial-gradient(520px 380px at 48% 92%, color-mix(in oklab, var(--blue) 14%, transparent), transparent 70%);
  }
  /* Yakın: küçük, daha parlak */
  .near {
    background:
      radial-gradient(280px 220px at 6% 30%, color-mix(in oklab, var(--blue) 26%, transparent), transparent 70%),
      radial-gradient(260px 200px at 80% 78%, color-mix(in oklab, var(--violet) 24%, transparent), transparent 70%),
      radial-gradient(220px 180px at 96% 16%, color-mix(in oklab, var(--blue) 20%, transparent), transparent 70%);
  }

  /* Kaydırma parallax'ı: tamamen CSS; desteklemeyen tarayıcıda katmanlar durağan */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .layer {
        animation: pbg-rise linear both;
      }
      /* Zaman çizelgesi ayrı kuralda: küçültücü bunu `animation` kısaltmasına katarsa
         tarayıcı bildirimi geçersiz sayıyor */
      .pbg > .layer {
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes pbg-rise {
    to {
      translate: 0 calc(-1 * var(--d));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .layer {
      transition: none;
    }
  }
</style>
