---
// Ana sayfadaki ilgi alanları: ince üst çizgili, yan yana sade bağlantılar.
// Her biri araştırma sayfasındaki ilgili karta gider (orada :target ile vurgulanır).
import { localePath, t, type Lang } from '../i18n';
import { research } from '../data/research';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const items = research.interests
  .map((i, idx) => ({ title: i.title[lang], href: localePath(lang, `/research#interest-${idx + 1}`) }))
  .filter((i) => i.title);
---

{
  items.length > 0 && (
    <ul class="interests" aria-label={ui.interests}>
      {items.map((i) => (
        <li>
          <a href={i.href}>
            {i.title} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .interests {
    list-style: none;
    margin: 40px 0 56px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 0 24px;
  }
  a {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 0 20px;
    border-top: 1px solid var(--ln2);
    color: var(--tx);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  /* Üzerine gelince üst çizgi soldan sağa vurgu rengiyle dolar */
  a::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ac);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  a:hover,
  a:focus-visible {
    color: var(--ac);
  }
  a:hover::before,
  a:focus-visible::before {
    transform: scaleX(1);
  }
  .arrow {
    color: var(--mu);
    transition:
      transform 0.25s var(--ease),
      color 0.2s;
  }
  a:hover .arrow {
    color: var(--ac);
    transform: translateX(4px);
  }
</style>
