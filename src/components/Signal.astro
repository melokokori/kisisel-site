---
// Ana sayfadaki imza çizgisi: her ilgi alanı bir sinyal tepesi. Tepeye ya da etiketine
// gelince o kesit parlar; tıklayınca araştırma sayfasındaki ilgili karta gider.
import { localePath, type Lang } from '../i18n';
import { research } from '../data/research';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const interests = research.interests.filter((i) => i.title[lang]);
const count = Math.max(interests.length, 3);

// 400×120'lik bir kesit: düz hat, küçük bir dalgalanma, tepe, yine dalgalanma.
// Her kesitin genliği biraz farklı, böylece çizgi kopyala-yapıştır gibi görünmez.
const amps = [1, 0.8, 1.15, 0.9, 1.05];
const segment = (amp: number) =>
  [
    [0, 0],
    [60, 0],
    [80, 2],
    [100, -2],
    [120, 0],
    [170, 0],
    [182, 20],
    [194, -32],
    [208, 42],
    [222, -20],
    [234, 0],
    [280, 0],
    [300, 3],
    [320, -3],
    [340, 0],
    [400, 0],
  ]
    .map(([x, dy]) => `${x},${60 - dy * amp}`)
    .join(' ');

const cols = Array.from({ length: count }, (_, i) => {
  const interest = interests[i];
  return {
    points: segment(amps[i % amps.length]),
    title: interest?.title[lang],
    href: interest ? localePath(lang, `/research#interest-${i + 1}`) : undefined,
  };
});
---

<div class="signal" style={`--n: ${count}`}>
  {
    cols.map((c, i) => {
      const Tag = c.href ? 'a' : 'div';
      return (
        <Tag class="col" href={c.href} style={`--i: ${i}`}>
          <svg viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="60" x2="400" y2="60" class="base" />
            <polyline class="pulse" points={c.points} />
          </svg>
          {c.title && (
            <span class="label">{c.title}</span>
          )}
        </Tag>
      );
    })
  }
</div>

<style>
  .signal {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 32px 0 56px;
  }
  .col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  svg {
    display: block;
    width: 100%;
    height: clamp(56px, 9vw, 112px);
    overflow: visible;
  }
  .base {
    stroke: var(--ln);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .pulse {
    fill: none;
    stroke: var(--ac);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition:
      opacity 0.25s,
      stroke-width 0.25s,
      filter 0.25s;
  }
  .label {
    padding: 0 8px;
    text-align: center;
    font-size: 14px;
    line-height: 1.35;
    color: var(--tx2);
    transition: color 0.2s;
  }

  /* Üzerine gelinen kesit parlar, diğerleri geri çekilir */
  .signal:has(a.col:hover, a.col:focus-visible) .col:not(:hover, :focus-visible) .pulse {
    opacity: 0.35;
  }
  a.col:is(:hover, :focus-visible) .pulse {
    stroke-width: 2.25;
    filter: var(--glow-line);
  }
  a.col:is(:hover, :focus-visible) .label {
    color: var(--ac);
  }
  a.col:focus-visible {
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Kesitler soldan sağa sırayla taranır; tek bir kesintisiz sinyal gibi görünür */
    .pulse {
      animation: sweep 0.55s linear both;
      animation-delay: calc(var(--i) * 0.55s + 0.15s);
    }
    .label {
      animation: fade 0.5s ease-out both;
      animation-delay: calc(var(--i) * 0.55s + 0.45s);
    }
  }
  @keyframes sweep {
    from {
      clip-path: inset(-50% 100% -50% 0);
    }
    to {
      clip-path: inset(-50% 0 -50% 0);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
</style>
