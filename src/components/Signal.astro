---
// Ana sayfadaki imza çizgisi: düz bir hatta iki kısa sinyal.
---

<svg viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
  <line x1="0" y1="60" x2="1200" y2="60" class="base"></line>
  <polyline
    class="pulse"
    points="0,60 120,60 150,58 170,62 200,60 320,60 340,40 352,92 366,22 380,78 392,60 520,60 540,56 560,64 580,60 700,60 716,30 728,96 742,12 756,84 770,60 900,60 930,57 960,63 990,60 1200,60"
  ></polyline>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: clamp(64px, 10vw, 120px);
    margin: 24px 0 72px;
  }
  .base {
    stroke: var(--ln);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .pulse {
    fill: none;
    stroke: var(--ac);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 2400;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: draw 1.6s ease-out both;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 2400;
    }
  }
</style>
