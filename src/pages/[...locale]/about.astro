---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Avatar from '../../components/Avatar.astro';
import EmailActions from '../../components/EmailActions.astro';
import { localeParams, t, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { education, experience, skills, languages, awards } from '../../data/cv';
import { socialLinks } from '../../lib/links';
import { formatDate } from '../../lib/content';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const range = (start: string, end?: string) => (end === start ? start : `${start} – ${end || ui.present}`);

// Eğitim ve deneyim tek zaman çizelgesinde, yeniden eskiye
const timeline = [
  ...education.map((e) => ({
    kind: ui.educationTag,
    start: e.start,
    period: range(e.start, e.end),
    title: e.degree[lang],
    org: e.institution[lang],
    url: undefined as string | undefined,
    notes: e.details?.[lang] ? [e.details[lang]] : [],
  })),
  ...experience.map((x) => ({
    kind: ui.experienceTag,
    start: x.start,
    period: range(x.start, x.end),
    title: x.role[lang],
    org: x.organization,
    url: x.url,
    notes: x.highlights.map((h) => h[lang]),
  })),
].sort((a, b) => b.start.localeCompare(a.start));

const contactLinks = socialLinks(lang);
const currentEdu = education.find((e) => !e.end) ?? education[0];

// Görünen bölümler sırayla numaralanır
let n = 0;
const next = () => String(++n).padStart(2, '0');
const num = {
  timeline: timeline.length > 0 ? next() : undefined,
  skills: skills.length > 0 ? next() : undefined,
  awards: awards.length > 0 ? next() : undefined,
  contact: next(),
};
---

<Base lang={lang} title={ui.nav.about}>
  <div class="about">
    <section class="story" aria-labelledby="about-title">
      <h1 id="about-title" class="display">{ui.nav.about}</h1>
      {profile.intro[lang] && <p class="opening">{profile.intro[lang]}</p>}
      {profile.bio.map((p) => <p class="para">{p[lang]}</p>)}
    </section>

    <aside class="side" aria-label={ui.atAGlance}>
      <Avatar lang={lang} eager sizes="(max-width: 860px) 220px, 300px" />
      <dl class="facts">
        {
          profile.now[lang] && (
            <div>
              <dt class="mono muted">{ui.now}</dt>
              <dd>{profile.now[lang]}</dd>
            </div>
          )
        }
        {
          currentEdu && (
            <div>
              <dt class="mono muted">{ui.education}</dt>
              <dd>
                {currentEdu.degree[lang]}
                <span class="muted">{currentEdu.institution[lang]}</span>
              </dd>
            </div>
          )
        }
        {
          languages.length > 0 && (
            <div>
              <dt class="mono muted">{ui.languages}</dt>
              <dd>
                {languages.map((l) => (
                  <span>
                    {l.name[lang]} <span class="muted">— {l.level[lang]}</span>
                  </span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
      {
        profile.cv[lang] && (
          <div class="cv">
            <a href={profile.cv[lang]} class="btn btn-primary" download>
              {ui.downloadCv}
            </a>
            {profile.cvUpdated && (
              <span class="mono muted">
                {ui.lastUpdated}: {formatDate(new Date(`${profile.cvUpdated}-01`), lang)}
              </span>
            )}
          </div>
        )
      }
    </aside>

    <div class="rest">
      <Section id="timeline" title={ui.educationExperience} filled={timeline.length > 0} num={num.timeline}>
        <ol class="timeline">
          {
            timeline.map((item) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <div>
                  <span class="mono muted">
                    {item.period} · {item.kind}
                  </span>
                  <h3>{item.title}</h3>
                  <span class="org">{item.url ? <a href={item.url}>{item.org}</a> : item.org}</span>
                  {item.notes.length > 0 && (
                    <ul>
                      {item.notes.map((n) => (
                        <li>{n}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="skills" title={ui.skills} filled={skills.length > 0} num={num.skills}>
        <div class="skills">
          {
            skills.map((s) => (
              <div class="card skill">
                <h3>{s.group[lang]}</h3>
                <ul class="pills">
                  {s.items.map((item) => (
                    <li class="pill">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </Section>

      <Section id="awards" title={ui.awards} filled={awards.length > 0} num={num.awards}>
        <ul class="plain">
          {
            awards.map((a) => (
              <li>
                {a.url ? <a href={a.url}>{a.title[lang]}</a> : a.title[lang]} —{' '}
                <span class="muted">
                  {a.issuer}, {a.year}
                </span>
              </li>
            ))
          }
        </ul>
      </Section>
    </div>
  </div>

  <section id="contact" class="card contact" aria-labelledby="contact-title">
    <h2 id="contact-title">
      <span class="num" aria-hidden="true">{num.contact}</span>
      {ui.contact}
    </h2>
    {profile.contactNote[lang] && <p class="note">{profile.contactNote[lang]}</p>}
    <EmailActions lang={lang}>
      {
        contactLinks.map((l) => (
          <a href={l.href} class="btn">
            {l.label}
          </a>
        ))
      }
    </EmailActions>
  </section>
</Base>

<style>
  /* Masaüstü: solda yapışkan künye (portre, kısa bilgiler, CV), sağda hikâye ve özgeçmiş.
     Mobil: hikâye → künye → zaman çizelgesi. */
  .about {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    grid-template-areas:
      'side story'
      'side rest';
    column-gap: clamp(40px, 6vw, 80px);
    padding-top: 64px;
  }
  .story {
    grid-area: story;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: 64px;
  }
  .side {
    grid-area: side;
    position: sticky;
    top: 24px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 64px;
  }
  .rest {
    grid-area: rest;
    min-width: 0;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'story' 'side' 'rest';
      padding-top: 48px;
    }
    .side {
      position: static;
      display: grid;
      grid-template-columns: minmax(120px, 200px) minmax(0, 1fr);
      align-items: start;
      gap: 24px;
    }
    .side .cv {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }
    .side :global(.avatar) {
      width: min(220px, 70%);
    }
  }
  .opening {
    font-size: 22px;
    line-height: 1.5;
  }
  .para {
    font-size: 17px;
    line-height: 1.75;
    color: var(--tx2);
    max-width: 62ch;
  }
  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--ln);
  }
  .facts dt {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .facts dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 15px;
    line-height: 1.5;
  }
  .cv {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .rest :global(.section:last-child) {
    padding-bottom: 72px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 20px;
    position: relative;
    padding-bottom: 36px;
  }
  .timeline > li:last-child {
    padding-bottom: 0;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: 9.5px;
    top: 20px;
    bottom: 0;
    width: 1px;
    background: var(--ln2);
  }
  .timeline > li:last-child::before {
    display: none;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    margin: 6px auto 0;
    background: var(--ac);
  }
  /* En güncel kayıt hafifçe parlar */
  .timeline > li:first-child .dot {
    box-shadow: 0 0 14px 2px color-mix(in oklab, var(--ac) 55%, transparent);
  }
  .timeline > li > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .timeline h3 {
    font-size: 20px;
  }
  .org {
    color: var(--tx2);
  }
  .timeline ul {
    margin: 4px 0 0;
    padding-left: 18px;
    color: var(--tx2);
    max-width: 62ch;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 16px;
  }
  .skill {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .skill h3 {
    font-size: 17px;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 17px;
  }
  .contact {
    margin: 8px 0 72px;
    padding: clamp(28px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    scroll-margin-top: 24px;
  }
  .contact h2 {
    font-size: clamp(36px, 5vw, 56px);
    letter-spacing: -0.03em;
  }
  .note {
    font-size: 18px;
    color: var(--tx2);
    max-width: 52ch;
  }
</style>
