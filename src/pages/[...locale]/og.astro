---
// Paylaşım önizleme kartı (1200×630). PNG'ler `npm run og` ile bu sayfadan üretilir.
import '../../styles/global.css';
import { localeParams, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { research } from '../../data/research';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const host = Astro.site?.host ?? 'melihturgut.dev';
const interests = research.interests.map((i) => i.title[lang]).join(' / ');
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — OG</title>
  </head>
  <body>
    <div class="og">
      <div class="text">
        <p class="mono accent">{interests}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role[lang]}</p>
        <p class="tagline">{profile.tagline[lang]}</p>
        <p class="mono host">{host}</p>
      </div>
      <svg viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="40" x2="1200" y2="40" class="base"></line>
        <polyline
          class="pulse"
          points="0,40 160,40 180,28 192,62 206,8 220,52 232,40 520,40 536,22 548,66 562,4 576,58 590,40 1200,40"
        ></polyline>
      </svg>
      <img src="/images/avatar-900.webp" alt="" width="360" height="450" />
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    padding: 72px 80px;
    display: flex;
    justify-content: space-between;
    background:
      radial-gradient(40% 60% at 82% 45%, color-mix(in srgb, var(--ac) 22%, transparent), transparent 70%),
      var(--bg);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
    z-index: 1;
  }
  .text .mono {
    font-size: 18px;
  }
  h1 {
    font-size: 96px;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .role {
    font-size: 22px;
    color: var(--mu);
  }
  .tagline {
    font-size: 30px;
    line-height: 1.35;
    color: var(--tx2);
  }
  .host {
    margin-top: auto;
    color: var(--tx);
  }
  img {
    position: absolute;
    right: 70px;
    bottom: 0;
    width: 380px;
    height: auto;
  }
  svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    width: 100%;
    height: 80px;
    opacity: 0.55;
  }
  .base {
    stroke: var(--ln);
    stroke-width: 1;
  }
  .pulse {
    fill: none;
    stroke: var(--ac);
    stroke-width: 2;
  }
</style>
