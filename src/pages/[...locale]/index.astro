---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import InterestList from '../../components/InterestList.astro';
import Avatar from '../../components/Avatar.astro';
import EmailActions from '../../components/EmailActions.astro';
import { localeParams, localePath, t, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { research, publications } from '../../data/research';
import { getProjects, getPosts, formatDate, readingTime } from '../../lib/content';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);

const projects = await getProjects(lang);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const cta = projects.length > 0 ? { href: '/projects', label: ui.nav.projects } : { href: '/about', label: ui.nav.about };
const recentPosts = (await getPosts(lang)).slice(0, 3);
const { thesis } = research;
const hasThesis = Boolean(thesis.title[lang]);
// Tez ya da yayın yoksa araştırma sayfasında yalnızca ilgi alanları vardır; bağlantı onu söylesin
const researchLink =
  hasThesis || publications.length > 0
    ? { href: localePath(lang, '/research'), label: ui.researchMore }
    : { href: localePath(lang, '/research#interests'), label: ui.researchInterests };

// Görünen bölümler sırayla numaralanır (boş bölüm numara almaz)
let n = 0;
const next = () => String(++n).padStart(2, '0');
const num = {
  featured: featured.length > 0 ? next() : undefined,
  research: next(),
  writing: recentPosts.length > 0 ? next() : undefined,
  contact: next(),
};
---

<Base lang={lang}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-text">
      {
        profile.now[lang] && (
          <p class="status mono">
            <span class="dot" aria-hidden="true" />
            <span>
              <span class="muted">{ui.now}:</span> {profile.now[lang]}
            </span>
          </p>
        )
      }
      <h1>{profile.name}</h1>
      {profile.role[lang] && <p class="role">{profile.role[lang]}</p>}
      {profile.tagline[lang] && <p class="lead">{profile.tagline[lang]}</p>}
      <div class="actions">
        <a href={localePath(lang, cta.href)} class="btn btn-primary">{cta.label}</a>
        {profile.cv[lang] && <a href={profile.cv[lang]} class="btn" download>{ui.downloadCv}</a>}
      </div>
    </div>
    <div class="hero-avatar"><Avatar lang={lang} eager /></div>
  </section>

  <InterestList lang={lang} />

  <Section
    id="featured"
    title={ui.featured}
    filled={featured.length > 0}
    more={{ href: localePath(lang, '/projects'), label: ui.allProjects }}
    num={num.featured}
  >
    <div class="grid-cards">
      {featured.map((p) => <ProjectCard lang={lang} slug={p.slug} {...p.data} />)}
    </div>
  </Section>

  <section class:list={['section research', { 'has-thesis': hasThesis }]} aria-labelledby="research-title">
    <div class="research-text">
      <h2 id="research-title" class="h2">
        <span class="num" aria-hidden="true">{num.research}</span>
        {ui.nav.research}
      </h2>
      {research.summary[lang] && <p class="lead">{research.summary[lang]}</p>}
      <a href={researchLink.href} class="link-arrow">
        {researchLink.label} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    {
      hasThesis && (
        <div class="card thesis">
          <span class="mono accent">{ui.thesisOngoing}</span>
          <span class="thesis-title">{thesis.title[lang]}</span>
          {thesis.advisor && (
            <span class="muted">
              {ui.advisor}: {thesis.advisor}
            </span>
          )}
        </div>
      )
    }
  </section>

  <Section
    id="writing"
    title={ui.recentPosts}
    filled={recentPosts.length > 0}
    more={{ href: localePath(lang, '/writing'), label: ui.allPosts }}
    num={num.writing}
  >
    <ul class="posts">
      {
        recentPosts.map((p) => (
          <li>
            <a href={localePath(lang, `/writing/${p.slug}`)}>{p.data.title}</a>
            <span class="mono muted">
              {formatDate(p.data.date, lang)} · {readingTime(p.body)} {ui.minRead}
            </span>
          </li>
        ))
      }
    </ul>
  </Section>

  <section class="card contact" aria-labelledby="contact-title">
    <div class="contact-text">
      <h2 id="contact-title" class="h2">
        <span class="num" aria-hidden="true">{num.contact}</span>
        {ui.contact}
      </h2>
      {profile.contactNote[lang] && <p>{profile.contactNote[lang]}</p>}
    </div>
    <EmailActions lang={lang} />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(32px, 7vw, 72px) 0 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 340px);
    align-items: center;
    gap: 48px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
  }
  /* En arka katman: portrenin arkasında yoğunlaşan, kenarlara doğru sönen ölçüm ızgarası */
  .hero-bg {
    position: absolute;
    z-index: -1;
    top: -160px;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    height: calc(100% + 280px);
    background: radial-gradient(circle, color-mix(in oklab, var(--ln2) 60%, var(--mu)) 1px, transparent 1.6px) 0 0 / 28px
      28px;
    mask-image: radial-gradient(ellipse 50% 65% at 62% 42%, #000 25%, transparent 78%);
    opacity: 0.9;
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .hero-bg {
      mask-image: radial-gradient(ellipse 80% 45% at 30% 22%, #000 15%, transparent 75%);
    }
  }

  /* Parallax: kaydırırken katmanlar farklı hızda hareket eder. Tamamen CSS (kaydırma
     zaman çizelgesi); desteklemeyen tarayıcıda ve hareket azaltma açıkken sayfa durağandır. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-bg,
      .hero-text,
      .hero-avatar {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .hero-bg {
        animation-name: depth-far;
      }
      .hero-avatar {
        animation-name: depth-mid;
      }
      /* Metin, sayfa ne kadar kaydı değil kendisi ekranın üstünden çıkarken söner;
         böylece mobilde uzun hero okunurken soluklaşmaz */
      .hero-text {
        animation-name: depth-near;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes depth-far {
    to {
      translate: 0 160px;
    }
  }
  @keyframes depth-mid {
    to {
      translate: 0 64px;
    }
  }
  @keyframes depth-near {
    50% {
      opacity: 1;
    }
    to {
      translate: 0 -40px;
      opacity: 0;
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .hero-avatar {
      order: -1;
      width: min(200px, 56%);
    }
  }
  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--tx2);
  }
  /* Canlı sinyal noktası: hafifçe nabız atar */
  .dot {
    position: relative;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ac);
    box-shadow: 0 0 10px color-mix(in oklab, var(--ac) 70%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--ac);
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }
  @keyframes ping {
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(56px, 9vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .role {
    margin-top: -8px;
    font-size: 17px;
    color: var(--mu);
  }
  .hero .lead {
    max-width: 36ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }
  .research-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 62ch;
  }
  .research.has-thesis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 48px;
  }
  .thesis {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-self: start;
  }
  .thesis-title {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--ln);
  }
  .posts li:last-child {
    border-bottom: 1px solid var(--ln);
  }
  .posts a {
    color: var(--tx);
    text-decoration: none;
    font-size: 20px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .posts a:hover {
    color: var(--ac);
  }
  .contact {
    margin: 8px 0 72px;
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    align-items: end;
    gap: 32px 48px;
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 48ch;
  }
  .contact p {
    color: var(--tx2);
  }
</style>
