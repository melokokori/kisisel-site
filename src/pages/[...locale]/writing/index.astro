---
import Base from '../../../layouts/Base.astro';
import { localeParams, localePath, t, type Lang } from '../../../i18n';
import { getPosts, formatDate, readingTime } from '../../../lib/content';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={ui.nav.writing}>
  <section class="intro">
    <h1 class="display">{ui.nav.writing}</h1>
  </section>

  {
    posts.length === 0 ? (
      <p class="empty">{ui.emptySection}</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={localePath(lang, `/writing/${p.slug}`)} class="title">
              {p.data.title}
            </a>
            <p>{p.data.description}</p>
            <span class="mono muted">
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time> · {readingTime(p.body)}{' '}
              {ui.minRead}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .intro {
    padding: 72px 0 40px;
  }
  .empty {
    margin-bottom: 88px;
  }
  .posts {
    list-style: none;
    margin: 0 0 88px;
    padding: 0;
  }
  .posts li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 0;
    border-top: 1px solid var(--ln);
  }
  .posts li:last-child {
    border-bottom: 1px solid var(--ln);
  }
  .title {
    color: var(--tx);
    text-decoration: none;
    font-size: clamp(20px, 2.6vw, 26px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .posts p {
    color: var(--tx2);
    max-width: 62ch;
  }
</style>
