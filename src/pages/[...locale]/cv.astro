---
// Yazdırılabilir CV (A4). PDF'ler `npm run cv:pdf` ile bu sayfadan üretilir.
import '../../styles/global.css';
import { localeParams, t, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { research } from '../../data/research';
import { education, experience, skills, languages, awards } from '../../data/cv';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const range = (start: string, end?: string) => (end === start ? start : `${start} – ${end || ui.present}`);
const site = Astro.site?.host ?? 'melihturgut.dev';
const contact = [
  profile.email && { label: profile.email, href: `mailto:${profile.email}` },
  { label: site, href: `https://${site}` },
  profile.links.linkedin && { label: 'linkedin.com/in/melihturgut1', href: profile.links.linkedin },
  profile.links.github && { label: profile.links.github.replace('https://', ''), href: profile.links.github },
].filter(Boolean) as { label: string; href: string }[];
const interests = research.interests.map((i) => i.title[lang]);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — CV</title>
  </head>
  <body>
    <main class="page">
      <header>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role[lang]}</p>
        <p class="contact mono">
          {contact.map((c) => <a href={c.href}>{c.label}</a>)}
        </p>
      </header>

      {profile.intro[lang] && <p class="intro">{profile.intro[lang]}</p>}

      {
        interests.length > 0 && (
          <section>
            <h2>{ui.interests}</h2>
            <p>{interests.join(' · ')}</p>
          </section>
        )
      }

      {
        education.length > 0 && (
          <section>
            <h2>{ui.education}</h2>
            {education.map((e) => (
              <div class="item">
                <div class="item-head">
                  <strong>{e.degree[lang]}</strong>
                  <span class="mono">{range(e.start, e.end)}</span>
                </div>
                <p class="org">
                  {e.institution[lang]}, {e.location}
                </p>
                {e.details?.[lang] && <p>{e.details[lang]}</p>}
              </div>
            ))}
          </section>
        )
      }

      {
        experience.length > 0 && (
          <section>
            <h2>{ui.experience}</h2>
            {experience.map((x) => (
              <div class="item">
                <div class="item-head">
                  <strong>{x.role[lang]}</strong>
                  <span class="mono">{range(x.start, x.end)}</span>
                </div>
                <p class="org">
                  {x.organization}, {x.location}
                </p>
                <ul>
                  {x.highlights.map((h) => (
                    <li>{h[lang]}</li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )
      }

      {
        skills.length > 0 && (
          <section>
            <h2>{ui.skills}</h2>
            <dl class="skills">
              {skills.map((s) => (
                <>
                  <dt>{s.group[lang]}</dt>
                  <dd>{s.items.join(', ')}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      {
        languages.length > 0 && (
          <section>
            <h2>{ui.languages}</h2>
            <p>{languages.map((l) => `${l.name[lang]} (${l.level[lang]})`).join(' · ')}</p>
          </section>
        )
      }

      {
        awards.length > 0 && (
          <section>
            <h2>{ui.awards}</h2>
            <ul>
              {awards.map((a) => (
                <li>
                  {a.title[lang]} — {a.issuer}, {a.year}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 16mm 16mm 14mm;
  }
  body {
    background: #fff;
    color: var(--tx);
    font-size: 10pt;
    line-height: 1.5;
  }
  .page {
    max-width: 178mm;
    margin: 0 auto;
    padding: 24px 0;
  }
  @media print {
    .page {
      padding: 0;
    }
  }
  header {
    padding-bottom: 10pt;
    margin-bottom: 12pt;
    border-bottom: 1.5pt solid var(--ac);
  }
  h1 {
    font-size: 26pt;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .role {
    margin-top: 3pt;
    font-size: 11pt;
    color: var(--tx2);
  }
  .contact {
    margin-top: 6pt;
    font-size: 8.5pt;
    display: flex;
    flex-wrap: wrap;
    gap: 2pt 14pt;
  }
  .contact a {
    color: var(--tx2);
    text-decoration: none;
  }
  .intro {
    margin-bottom: 4pt;
    color: var(--tx2);
  }
  section {
    margin-top: 12pt;
    break-inside: avoid;
  }
  h2 {
    font-size: 9pt;
    font-weight: 600;
    color: var(--ac);
    font-family: var(--mono);
    letter-spacing: 0.02em;
    padding-bottom: 3pt;
    margin-bottom: 6pt;
    border-bottom: 0.5pt solid var(--ln);
  }
  .item {
    margin-bottom: 8pt;
    break-inside: avoid;
  }
  .item-head {
    display: flex;
    justify-content: space-between;
    gap: 12pt;
    align-items: baseline;
  }
  .item-head .mono {
    font-size: 8.5pt;
    color: var(--mu);
    white-space: nowrap;
  }
  .org {
    color: var(--tx2);
  }
  ul {
    margin: 3pt 0 0;
    padding-left: 12pt;
    color: var(--tx2);
  }
  li + li {
    margin-top: 1.5pt;
  }
  .skills {
    margin: 0;
    display: grid;
    grid-template-columns: 34mm 1fr;
    gap: 3pt 10pt;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 0;
    color: var(--tx2);
  }
</style>
