---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { localeParams, t, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { education, experience, skills, languages, awards } from '../../data/cv';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const present = lang === 'tr' ? 'Devam ediyor' : 'Present';
const range = (start: string, end?: string) => `${start} – ${end || present}`;
---

<Base lang={lang} title={ui.nav.cv}>
  <h1>{ui.nav.cv}</h1>
  {profile.cv[lang] && <p><a href={profile.cv[lang]} download>{ui.downloadCv}</a></p>}

  <Section id="education" title={ui.education} lang={lang} filled={education.length > 0}>
    {education.map((e) => (
      <article>
        <h3>{e.degree[lang]}</h3>
        <p>{e.institution} · {e.location} · {range(e.start, e.end)}</p>
        {e.details?.[lang] && <p>{e.details[lang]}</p>}
      </article>
    ))}
  </Section>

  <Section id="experience" title={ui.experience} lang={lang} filled={experience.length > 0}>
    {experience.map((x) => (
      <article>
        <h3>{x.role[lang]}</h3>
        <p>{x.url ? <a href={x.url}>{x.organization}</a> : x.organization} · {x.location} · {range(x.start, x.end)}</p>
        <ul>{x.highlights.map((h) => <li>{h[lang]}</li>)}</ul>
      </article>
    ))}
  </Section>

  <Section id="skills" title={ui.skills} lang={lang} filled={skills.length > 0}>
    <dl>
      {skills.map((s) => (
        <>
          <dt>{s.group[lang]}</dt>
          <dd>{s.items.join(', ')}</dd>
        </>
      ))}
    </dl>
  </Section>

  <Section id="languages" title={ui.languages} lang={lang} filled={languages.length > 0}>
    <ul>{languages.map((l) => <li>{l.name[lang]} — {l.level}</li>)}</ul>
  </Section>

  <Section id="awards" title={ui.awards} lang={lang} filled={awards.length > 0}>
    <ul>
      {awards.map((a) => (
        <li>{a.url ? <a href={a.url}>{a.title[lang]}</a> : a.title[lang]} — {a.issuer}, {a.year}</li>
      ))}
    </ul>
  </Section>
</Base>
